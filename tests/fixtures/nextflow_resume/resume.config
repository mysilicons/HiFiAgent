process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    time = '5 min'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
}

cleanup = false

trace {
    enabled = true
    file = "${params.outdir}/trace.txt"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/report.html"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/dag.html"
    overwrite = true
}
