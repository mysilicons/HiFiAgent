manifest {
    name = 'hifi-agent'
    description = 'HiFi Agent V1 minimal Nextflow workflow'
    mainScript = 'main.nf'
}

params {
    sample_id = null
    assembly_run_id = 'baseline'
    hifiasm_purge_level = 3
    hifiasm_purge_similarity = 0.55
    hifiasm_hom_cov = null
    hifiasm_disable_post_join = false
    validation_receipt = null
    bin_reuse_manifest = null
    reads = null
    reads_manifest = null
    expected_genome_size = null
    kmer_k = 21
    kmer_low_coverage_peak_threshold = 10.0
    kmer_reads_manifest = null
    kmer_source = 'same_data_advisory'
    run_assembly = true
    run_post_qc = true
    reference_genome = null
    busco_lineage = null
    busco_download_path = '/data/gw/BUSCO'
    busco_timeout_minutes = 240
    coverage_window_size = 10000
    mapping_min_read_length = 1000
    mapping_min_mean_qscore = 20.0
    // The target host has 512 logical CPUs and 1 TiB RAM. Leave capacity for
    // Nextflow, the operating system, and filesystem cache.
    max_threads = 480
    max_memory_gb = 960
    assembly_fasta = null
    assembly_manifest = null
    meryl_db = null
    kmer_histogram = null
    raw_metrics = null
    outdir = "${projectDir}/../results/phase3_minimal"
    publish_mode = 'copy'
    publish_overwrite = false
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'

    withLabel: small {
        cpus = 1
        memory = '4 GB'
        time = '30 min'
    }

    withLabel: medium {
        cpus = Math.min(256, params.max_threads as int)
        memory = "${Math.min(512, params.max_memory_gb as int)} GB"
        time = '4 h'
    }

    withLabel: assembly {
        cpus = params.max_threads as int
        memory = "${params.max_memory_gb as int} GB"
        time = '48 h'
    }

    withLabel: post_qc {
        cpus = Math.min(128, params.max_threads as int)
        memory = "${Math.min(256, params.max_memory_gb as int)} GB"
        time = '24 h'
    }

    // Tool-specific selectors override the broad labels above. Their combined
    // requests let the local executor schedule safe post-QC combinations.
    withName: SEQKIT_STATS {
        cpus = Math.min(32, params.max_threads as int)
        memory = "${Math.min(32, params.max_memory_gb as int)} GB"
    }

    withName: NANOPLOT {
        cpus = Math.min(64, params.max_threads as int)
        memory = "${Math.min(128, params.max_memory_gb as int)} GB"
    }

    withName: MERQURY_POST_QC {
        cpus = Math.min(64, params.max_threads as int)
        memory = "${Math.min(128, params.max_memory_gb as int)} GB"
    }

    withName: MAPPING_POST_QC {
        cpus = Math.min(64, params.max_threads as int)
        memory = "${Math.min(128, params.max_memory_gb as int)} GB"
    }

    withName: QUAST {
        cpus = Math.min(32, params.max_threads as int)
        memory = "${Math.min(64, params.max_memory_gb as int)} GB"
    }

    withName: BUSCO_POST_QC {
        cpus = Math.min(64, params.max_threads as int)
        memory = "${Math.min(128, params.max_memory_gb as int)} GB"
    }
}

cleanup = false
